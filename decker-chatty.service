[Unit]
Description=Decker Chatty - Proxy Server for OpenAI API
After=network.target

[Service]
Type=simple
User=tramberend-admin
WorkingDirectory=/home/tramberend-admin/server/decker-chatty
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=10
# Logs go to the journal (journalctl -u decker-chatty); no file redirect.

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
